{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "paths": { "@strata-engine/core": ["./packages/core/src/index.ts"] },
    "noEmit": true
  },
  "include": ["packages/core/src/**/*.ts", "benchmarks/src/**/*.ts"]
}
