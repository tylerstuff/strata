{
  "name": "@strata-engine/preview",
  "version": "0.0.0",
  "description": "Optional Node orchestration for deterministic Strata preview captures.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@strata-engine/authoring": "0.0.0",
    "@strata-engine/core": "0.0.0",
    "playwright": "1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylerstuff/strata.git",
    "directory": "packages/preview"
  },
  "bin": {
    "strata-preview": "./dist/bin.js"
  }
}
