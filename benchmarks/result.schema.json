{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tylerstuff/strata/benchmarks/result.schema.json",
  "title": "Strata browser benchmark session v1",
  "description": "RAF callback cadence, CPU submission and optional GPU pass timings are separate. All units are milliseconds or bytes. Additional metadata is permitted. A session includes one or more runs.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "createdAt",
    "mode",
    "host",
    "source",
    "browser",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "strata-local-benchmark-session"
    },
    "createdAt": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "performance",
        "sustained",
        "smoke"
      ]
    },
    "host": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "browser": {
      "type": "object"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "giTelemetry": {
      "type": "object",
      "required": ["sourceFrameId", "worldRevision", "cacheEpoch", "enabled", "probeCount", "probesPerUpdate", "raysPerProbe", "primaryRaysPerFrame", "maxShadowRaysPerFrame", "updatePeriodFrames", "framesSinceReset", "probeUpdatesSinceReset", "submittedFrames", "primaryRaysSubmitted", "validProbeCount", "traceFailures", "hysteresis", "maxTraceDistance", "doorOpen", "wallColor", "lightIntensity", "traceRepresentation", "traceGeometryBytes", "cacheBufferBytes", "cacheTextureBytes", "composeBufferBytes", "composeTextureBytes"],
      "properties": {
        "sourceFrameId": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967295 },
        "worldRevision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "cacheEpoch": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "enabled": { "type": "boolean" },
        "probeCount": { "const": 384 },
        "probesPerUpdate": { "type": "integer", "minimum": 1, "maximum": 128 },
        "raysPerProbe": { "type": "integer", "minimum": 16, "maximum": 128 },
        "primaryRaysPerFrame": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "maxShadowRaysPerFrame": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "updatePeriodFrames": { "type": "integer", "minimum": 3, "maximum": 384 },
        "framesSinceReset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "probeUpdatesSinceReset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "submittedFrames": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "primaryRaysSubmitted": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "validProbeCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 384 },
        "traceFailures": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "hysteresis": { "type": "number", "minimum": 0, "maximum": 0.95 },
        "maxTraceDistance": { "const": 32 },
        "doorOpen": { "type": "boolean" },
        "wallColor": { "enum": ["red", "neutral"] },
        "lightIntensity": { "type": "number", "minimum": 0, "maximum": 8 },
        "traceRepresentation": { "const": "triangle-bvh-v1" },
        "traceGeometryBytes": { "type": "integer", "minimum": 0 },
        "cacheBufferBytes": { "type": "integer", "minimum": 0 },
        "cacheTextureBytes": { "type": "integer", "minimum": 0 },
        "composeBufferBytes": { "type": "integer", "minimum": 0 },
        "composeTextureBytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": {
        "anyOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }, { "type": "null" }]
      }
    },
    "giWorkload": {
      "type": "object",
      "required": ["renderer", "temporal", "debugView", "giEnabled", "giScenario", "sourceTriangleCount"],
      "properties": {
        "id": { "const": "two-room-software-gi-v1" },
        "renderer": { "const": "gi" },
        "seed": { "const": 1337 },
        "instanceCount": { "const": 0 },
        "renderPath": { "const": "world-space-diffuse-gi-v1" },
        "cameraPath": { "enum": ["gi-receiver-v1", "gi-overview-v1", "gi-tour-v1"] },
        "temporal": { "type": "boolean" },
        "debugView": { "enum": ["final", "direct", "shadow", "depth", "normal", "motion", "material", "clusters", "lod", "residency", "coverage", "indirect", "trace", "probe-age", "probe-irradiance", "probe-visibility"] },
        "giEnabled": { "type": "boolean" },
        "giScenario": { "enum": ["static", "door-light"] },
        "sourceTriangleCount": { "const": 132 },
        "externalAssetsUsed": { "const": false }
      }
    },
    "giQuality": {
      "type": "object",
      "required": ["giEnabled", "probesPerUpdate", "raysPerProbe", "traceRepresentation", "grid", "maxTraceDistance", "screenTracing", "giScenario", "scenarioPeriodSeconds", "events", "materialFixture"],
      "properties": {
        "giEnabled": { "type": "boolean" },
        "probesPerUpdate": { "type": "integer", "minimum": 1, "maximum": 128 },
        "raysPerProbe": { "type": "integer", "minimum": 16, "maximum": 128 },
        "traceRepresentation": { "const": "triangle-bvh-v1" },
        "grid": { "const": [12, 4, 8] },
        "maxTraceDistance": { "const": 32 },
        "screenTracing": { "const": false },
        "giScenario": { "enum": ["static", "door-light"] },
        "scenarioPeriodSeconds": { "const": 60 },
        "materialFixture": { "const": "shared-flat-lambertian-v1" },
        "events": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["atSeconds"],
            "properties": {
              "atSeconds": { "type": "number", "minimum": 0, "exclusiveMaximum": 60 },
              "doorOpen": { "type": "boolean" },
              "lightIntensity": { "type": "number", "minimum": 0, "maximum": 8 },
              "wallColor": { "enum": ["red", "neutral"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "required": [
        "count",
        "min",
        "mean",
        "p50",
        "p95",
        "p99",
        "max"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p99": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "frameId",
        "elapsedMs",
        "frameIntervalMs",
        "cpuSubmissionMs",
        "drawCalls",
        "dispatchCalls",
        "triangles",
        "uploadBytes",
        "allocatedGpuBufferBytes",
        "allocatedGpuTextureBytes",
        "gpuMs"
      ],
      "properties": {
        "frameId": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "frameIntervalMs": {
          "type": "number",
          "minimum": 0
        },
        "cpuSubmissionMs": {
          "type": "number",
          "minimum": 0
        },
        "drawCalls": {
          "type": "integer",
          "minimum": 0
        },
        "dispatchCalls": {
          "type": "integer",
          "minimum": 0
        },
        "triangles": {
          "type": "integer",
          "minimum": 0
        },
        "uploadBytes": {
          "type": "integer",
          "minimum": 0
        },
        "allocatedGpuBufferBytes": {
          "type": "integer",
          "minimum": 0
        },
        "allocatedGpuTextureBytes": {
          "type": "integer",
          "minimum": 0
        },
        "gpuMs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpuPasses": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "gpuSpanMs": { "type": ["number", "null"], "minimum": 0 },
        "gpuPassIntervals": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "required": ["startMs", "endMs"], "additionalProperties": false,
            "properties": {
              "startMs": { "type": "number", "minimum": 0 },
              "endMs": { "type": "number", "minimum": 0 }
            }
          }
        },
        "triangleCountSourceFrameId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "geometry": {
          "type": "object",
          "required": [
            "sourceFrameId"
          ],
          "properties": {
            "sourceFrameId": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "gi": {
          "$ref": "#/$defs/giTelemetry"
        }
      }
    },
    "run": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "workload": { "type": "object", "properties": { "renderer": { "const": "gi" } }, "required": ["renderer"] }
            }
          },
          "then": {
            "required": ["quality"],
            "properties": {
              "workload": { "$ref": "#/$defs/giWorkload" },
              "quality": { "$ref": "#/$defs/giQuality" },
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["gi", "gpuPasses", "triangleCountSourceFrameId"],
                  "properties": {
                    "gi": { "$ref": "#/$defs/giTelemetry" },
                    "gpuPasses": { "type": "object" },
                    "triangleCountSourceFrameId": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "allocations": { "type": "object", "required": ["gi"], "properties": { "gi": { "$ref": "#/$defs/giTelemetry" } } }
            }
          }
        }
      ],
      "required": [
        "schemaVersion",
        "startedAt",
        "completedAt",
        "mode",
        "workload",
        "resolution",
        "capture",
        "browser",
        "adapter",
        "capabilities",
        "profiling",
        "coldStart",
        "assetTraffic",
        "allocations",
        "summary",
        "gpuPasses",
        "metadata",
        "limitations",
        "frames"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "startedAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "performance",
            "sustained",
            "smoke"
          ]
        },
        "workload": {
          "type": "object",
          "required": [
            "id",
            "seed",
            "instanceCount",
            "cameraPath",
            "renderPath",
            "externalAssetsUsed"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "instanceCount": {
              "type": "integer",
              "minimum": 0
            },
            "cameraPath": {
              "type": "string"
            },
            "renderPath": {
              "type": "string"
            },
            "externalAssetsUsed": {
              "type": "boolean"
            },
            "renderer": {
              "enum": ["diffuse", "raster", "virtual", "gi"]
            },
            "temporal": {
              "type": "boolean"
            }
          }
        },
        "resolution": {
          "type": "object",
          "required": [
            "width",
            "height",
            "devicePixelRatio",
            "cssWidth",
            "cssHeight",
            "screenWidth",
            "screenHeight"
          ],
          "properties": {
            "width": {
              "enum": [
                1280,
                1920
              ]
            },
            "height": {
              "enum": [
                720,
                1080
              ]
            },
            "devicePixelRatio": {
              "type": "number",
              "minimum": 0
            },
            "cssWidth": {
              "type": "number",
              "minimum": 0
            },
            "cssHeight": {
              "type": "number",
              "minimum": 0
            },
            "screenWidth": {
              "type": "number",
              "minimum": 0
            },
            "screenHeight": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "capture": {
          "type": "object",
          "required": [
            "warmupSeconds",
            "requestedDurationSeconds",
            "actualDurationMs",
            "frameCount",
            "visibilityChanges"
          ],
          "properties": {
            "warmupSeconds": {
              "type": "number",
              "minimum": 0
            },
            "requestedDurationSeconds": {
              "type": "number",
              "minimum": 0
            },
            "actualDurationMs": {
              "type": "number",
              "minimum": 0
            },
            "frameCount": {
              "type": "integer",
              "minimum": 0
            },
            "visibilityChanges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "atMs",
                  "state"
                ],
                "properties": {
                  "atMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "state": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "browser": {
          "type": "object",
          "required": [
            "userAgent",
            "hardwareConcurrency",
            "crossOriginIsolated",
            "secureContext"
          ],
          "properties": {
            "userAgent": {
              "type": "string"
            },
            "hardwareConcurrency": {
              "type": "integer",
              "minimum": 0
            },
            "crossOriginIsolated": {
              "type": "boolean"
            },
            "secureContext": {
              "type": "boolean"
            }
          }
        },
        "adapter": {
          "type": "object",
          "required": [
            "vendor",
            "architecture",
            "device",
            "description",
            "isFallbackAdapter"
          ],
          "properties": {
            "vendor": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "device": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "isFallbackAdapter": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "adapterFeatures",
            "adapterLimits",
            "deviceLimits"
          ],
          "properties": {
            "adapterFeatures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "adapterLimits": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "deviceLimits": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "profiling": {
          "type": "object",
          "required": [
            "enabled",
            "gpuTimestampAvailable",
            "reason",
            "timestampPrecision",
            "capturedGpuSamples",
            "droppedGpuSamples",
            "pendingGpuSamples"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gpuTimestampAvailable": {
              "type": "boolean"
            },
            "reason": {
              "enum": [
                "disabled",
                "available",
                "timestamp-query-unavailable",
                "timestamp-query-device-request-failed"
              ]
            },
            "timestampPrecision": {
              "const": "browser-dependent"
            },
            "capturedGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "droppedGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "pendingGpuSamples": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "coldStart": {
          "type": "object",
          "required": [
            "initializeMs",
            "sceneSetupMs",
            "uploadBytes"
          ],
          "properties": {
            "initializeMs": {
              "type": "number",
              "minimum": 0
            },
            "sceneSetupMs": {
              "type": "number",
              "minimum": 0
            },
            "uploadBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "assetTraffic": {
          "type": "object",
          "required": [
            "externalAssetsUsed",
            "steadyUploadBytes",
            "documentResourceTransferBytes",
            "documentResourceDecodedBytes",
            "note"
          ],
          "properties": {
            "externalAssetsUsed": {
              "type": "boolean"
            },
            "steadyUploadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "documentResourceTransferBytes": {
              "type": "integer",
              "minimum": 0
            },
            "documentResourceDecodedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "string"
            }
          }
        },
        "allocations": {
          "type": "object",
          "required": [
            "submittedFrames",
            "totalUploadBytes",
            "allocatedGpuBufferBytes",
            "allocatedGpuTextureBytes",
            "wasmMemoryBytes",
            "pendingGpuSamples",
            "droppedGpuSamples",
            "note"
          ],
          "properties": {
            "submittedFrames": {
              "type": "integer",
              "minimum": 0
            },
            "totalUploadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "allocatedGpuBufferBytes": {
              "type": "integer",
              "minimum": 0
            },
            "allocatedGpuTextureBytes": {
              "type": "integer",
              "minimum": 0
            },
            "wasmMemoryBytes": {
              "type": "integer",
              "minimum": 0
            },
            "pendingGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "droppedGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "string"
            },
            "gi": {
              "$ref": "#/$defs/giTelemetry"
            }
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "frameIntervalMs",
            "cpuSubmissionMs",
            "gpuPassMs",
            "meanCallbackCadenceFps",
            "framesAbove20Ms",
            "targetFrameIntervalMs",
            "drawCalls",
            "dispatchCalls",
            "uploadBytes",
            "maxTrackedGpuBufferBytes",
            "maxTrackedGpuTextureBytes"
          ],
          "properties": {
            "frameIntervalMs": {
              "$ref": "#/$defs/distribution"
            },
            "cpuSubmissionMs": {
              "$ref": "#/$defs/distribution"
            },
            "gpuPassMs": {
              "$ref": "#/$defs/distribution"
            },
            "gpuSpanMs": { "$ref": "#/$defs/distribution" },
            "meanCallbackCadenceFps": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "framesAbove20Ms": {
              "type": "integer",
              "minimum": 0
            },
            "targetFrameIntervalMs": {
              "type": "number",
              "minimum": 0
            },
            "drawCalls": {
              "type": "integer",
              "minimum": 0
            },
            "dispatchCalls": {
              "type": "integer",
              "minimum": 0
            },
            "uploadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxTrackedGpuBufferBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxTrackedGpuTextureBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "gpuPasses": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "sampleCount",
              "totalMs"
            ],
            "properties": {
              "sampleCount": {
                "type": "integer",
                "minimum": 0
              },
              "totalMs": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "metadata": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    }
  }
}
