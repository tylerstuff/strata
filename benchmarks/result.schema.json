            "type": "number",
            "minimum": 0
          }
        },
        "gpuSpanMs": { "type": ["number", "null"], "minimum": 0 },
        "gpuPassIntervals": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "required": ["startMs", "endMs"], "additionalProperties": false,
            "properties": {
              "startMs": { "type": "number", "minimum": 0 },
              "endMs": { "type": "number", "minimum": 0 }
            }
          }
        },
        "triangleCountSourceFrameId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "geometry": {
          "type": "object",
          "required": [
            "sourceFrameId"
          ],
          "properties": {
            "sourceFrameId": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "gi": {
          "$ref": "#/$defs/giTelemetry"
        },
        "reflections": { "$ref": "#/$defs/reflectionTelemetry" },
        "integrated": { "$ref": "#/$defs/integratedTelemetry" }
      }
    },
    "run": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "workload": {
                "type": "object",
                "properties": {
                  "renderer": {
                    "const": "integrated"
                  }
                },
                "required": [
                  "renderer"
                ]
              }
            }
          },
          "then": {
            "required": [
              "quality"
            ],
            "properties": {
              "workload": {
                "$ref": "#/$defs/integratedWorkload"
              },
              "quality": {
                "$ref": "#/$defs/integratedQuality"
              },
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "gi",
                    "gpuPasses",
                    "triangleCountSourceFrameId",
                    "reflections",
                    "geometry",
                    "integrated"
                  ],
                  "properties": {
                    "gi": {
                      "$ref": "#/$defs/giTelemetry"
                    },
                    "gpuPasses": {
                      "type": "object"
                    },
                    "triangleCountSourceFrameId": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "reflections": {
                      "$ref": "#/$defs/reflectionTelemetry"
                    },
                    "integrated": {
                      "$ref": "#/$defs/integratedTelemetry"
                    },
                    "geometry": {
                      "type": "object"
                    }
                  }
                }
              },
              "allocations": {
                "type": "object",
                "required": [
                  "gi",
                  "reflections",
                  "geometry",
                  "integrated"
                ],
                "properties": {
                  "gi": {
                    "$ref": "#/$defs/giTelemetry"
                  },
                  "reflections": {
                    "$ref": "#/$defs/reflectionTelemetry"
                  },
                  "integrated": {
                    "$ref": "#/$defs/integratedTelemetry"
                  },
                  "geometry": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workload": { "type": "object", "properties": { "renderer": { "const": "gi" } }, "required": ["renderer"] }
            }
          },
          "then": {
            "required": ["quality"],
            "properties": {
              "workload": { "$ref": "#/$defs/giWorkload" },
              "quality": { "$ref": "#/$defs/giQuality" },
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["gi", "gpuPasses", "triangleCountSourceFrameId"],
                  "properties": {
                    "gi": { "$ref": "#/$defs/giTelemetry" },
                    "gpuPasses": { "type": "object" },
                    "triangleCountSourceFrameId": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              "allocations": { "type": "object", "required": ["gi"], "properties": { "gi": { "$ref": "#/$defs/giTelemetry" } } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workload": {
                "type": "object",
                "properties": {
                  "renderer": {
                    "const": "reflections"
                  }
                },
                "required": [
                  "renderer"
                ]
              }
            }
          },
          "then": {
            "required": [
              "quality"
            ],
            "properties": {
              "workload": {
                "$ref": "#/$defs/reflectionWorkload"
              },
              "quality": {
                "$ref": "#/$defs/reflectionQuality"
              },
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "gi",
                    "gpuPasses",
                    "triangleCountSourceFrameId",
                    "reflections"
                  ],
                  "properties": {
                    "gi": {
                      "$ref": "#/$defs/giTelemetry"
                    },
                    "gpuPasses": {
                      "type": "object"
                    },
                    "triangleCountSourceFrameId": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "reflections": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/reflectionTelemetry"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "objectOffset": {
                              "const": 0
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "allocations": {
                "type": "object",
                "required": [
                  "gi",
                  "reflections"
                ],
                "properties": {
                  "gi": {
                    "$ref": "#/$defs/giTelemetry"
                  },
                  "reflections": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/reflectionTelemetry"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "objectOffset": {
                            "const": 0
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "required": [
        "schemaVersion",
        "startedAt",
        "completedAt",
        "mode",
        "workload",
        "resolution",
        "capture",
        "browser",
        "adapter",
        "capabilities",
        "profiling",
        "coldStart",
        "assetTraffic",
        "allocations",
        "summary",
        "gpuPasses",
        "metadata",
        "limitations",
        "frames"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "startedAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "performance",
            "sustained",
            "smoke"
          ]
        },
        "workload": {
          "type": "object",
          "required": [
            "id",
            "seed",
            "instanceCount",
            "cameraPath",
            "renderPath",
            "externalAssetsUsed"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "instanceCount": {
              "type": "integer",
              "minimum": 0
            },
            "cameraPath": {
              "type": "string"
            },
            "renderPath": {
              "type": "string"
            },
            "externalAssetsUsed": {
              "type": "boolean"
            },
            "renderer": {
              "enum": ["diffuse", "raster", "virtual", "gi", "reflections", "integrated"]
            },
            "temporal": {
              "type": "boolean"
            }
          }
        },
        "resolution": {
          "type": "object",
          "required": [
            "width",
            "height",
            "devicePixelRatio",
            "cssWidth",
            "cssHeight",
            "screenWidth",
            "screenHeight"
          ],
          "properties": {
            "width": {
              "enum": [
                1280,
                1920
              ]
            },
            "height": {
              "enum": [
                720,
                1080
              ]
            },
            "devicePixelRatio": {
              "type": "number",
              "minimum": 0
            },
            "cssWidth": {
              "type": "number",
              "minimum": 0
            },
            "cssHeight": {
              "type": "number",
              "minimum": 0
            },
            "screenWidth": {
              "type": "number",
              "minimum": 0
            },
            "screenHeight": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "capture": {
          "type": "object",
          "required": [
            "warmupSeconds",
            "requestedDurationSeconds",
            "actualDurationMs",
            "frameCount",
            "visibilityChanges"
          ],
          "properties": {
            "warmupSeconds": {
              "type": "number",
              "minimum": 0
            },
            "requestedDurationSeconds": {
              "type": "number",
              "minimum": 0
            },
            "actualDurationMs": {
              "type": "number",
              "minimum": 0
            },
            "frameCount": {
              "type": "integer",
              "minimum": 0
            },
            "visibilityChanges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "atMs",
                  "state"
                ],
                "properties": {
                  "atMs": {
                    "type": "number",
                    "minimum": 0
                  },
                  "state": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "browser": {
          "type": "object",
          "required": [
            "userAgent",
            "hardwareConcurrency",
            "crossOriginIsolated",
            "secureContext"
          ],
          "properties": {
            "userAgent": {
              "type": "string"
            },
            "hardwareConcurrency": {
              "type": "integer",
              "minimum": 0
            },
            "crossOriginIsolated": {
              "type": "boolean"
            },
            "secureContext": {
              "type": "boolean"
            }
          }
        },
        "adapter": {
          "type": "object",
          "required": [
            "vendor",
            "architecture",
            "device",
            "description",
            "isFallbackAdapter"
          ],
          "properties": {
            "vendor": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "device": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "isFallbackAdapter": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "adapterFeatures",
            "adapterLimits",
            "deviceLimits"
          ],
          "properties": {
            "adapterFeatures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "adapterLimits": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "deviceLimits": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "profiling": {
          "type": "object",
          "required": [
            "enabled",
            "gpuTimestampAvailable",
            "reason",
            "timestampPrecision",
            "capturedGpuSamples",
            "droppedGpuSamples",
            "pendingGpuSamples"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gpuTimestampAvailable": {
              "type": "boolean"
            },
            "reason": {
              "enum": [
                "disabled",
                "available",
                "timestamp-query-unavailable",
                "timestamp-query-device-request-failed"
              ]
            },
            "timestampPrecision": {
              "const": "browser-dependent"
            },
            "capturedGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "droppedGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "pendingGpuSamples": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "coldStart": {
          "type": "object",
          "required": [
            "initializeMs",
            "sceneSetupMs",
            "uploadBytes"
          ],
          "properties": {
            "initializeMs": {
              "type": "number",
              "minimum": 0
            },
            "sceneSetupMs": {
              "type": "number",
              "minimum": 0
            },
            "uploadBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "assetTraffic": {
          "type": "object",
          "required": [
            "externalAssetsUsed",
            "steadyUploadBytes",
            "documentResourceTransferBytes",
            "documentResourceDecodedBytes",
            "note"
          ],
          "properties": {
            "externalAssetsUsed": {
              "type": "boolean"
            },
            "steadyUploadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "documentResourceTransferBytes": {
              "type": "integer",
              "minimum": 0
            },
            "documentResourceDecodedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "string"
            }
          }
        },
        "allocations": {
          "type": "object",
          "required": [
            "submittedFrames",
            "totalUploadBytes",
            "allocatedGpuBufferBytes",
            "allocatedGpuTextureBytes",
            "wasmMemoryBytes",
            "pendingGpuSamples",
            "droppedGpuSamples",
            "note"
          ],
          "properties": {
            "submittedFrames": {
              "type": "integer",
              "minimum": 0
            },
            "totalUploadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "allocatedGpuBufferBytes": {
              "type": "integer",
              "minimum": 0
            },
            "allocatedGpuTextureBytes": {
              "type": "integer",
              "minimum": 0
            },
            "wasmMemoryBytes": {
              "type": "integer",
              "minimum": 0
            },
            "pendingGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "droppedGpuSamples": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "string"
            },
            "gi": {
              "$ref": "#/$defs/giTelemetry"
            }
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "frameIntervalMs",
            "cpuSubmissionMs",
            "gpuPassMs",
            "meanCallbackCadenceFps",
            "framesAbove20Ms",
            "targetFrameIntervalMs",
            "drawCalls",
            "dispatchCalls",
            "uploadBytes",
            "maxTrackedGpuBufferBytes",
            "maxTrackedGpuTextureBytes"
          ],
          "properties": {
            "frameIntervalMs": {
              "$ref": "#/$defs/distribution"
            },
            "cpuSubmissionMs": {
              "$ref": "#/$defs/distribution"
            },
            "gpuPassMs": {
              "$ref": "#/$defs/distribution"
            },
            "gpuSpanMs": { "$ref": "#/$defs/distribution" },
            "meanCallbackCadenceFps": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "framesAbove20Ms": {
              "type": "integer",
              "minimum": 0
            },
            "targetFrameIntervalMs": {
              "type": "number",
              "minimum": 0
            },
            "drawCalls": {
              "type": "integer",
              "minimum": 0
            },
            "dispatchCalls": {
              "type": "integer",
              "minimum": 0
            },
            "uploadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxTrackedGpuBufferBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxTrackedGpuTextureBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "gpuPasses": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "sampleCount",
              "totalMs"
            ],
            "properties": {
              "sampleCount": {
                "type": "integer",
                "minimum": 0
              },
              "totalMs": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "metadata": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
