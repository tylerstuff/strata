{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tylerstuff/strata/benchmarks/result.schema.json",
  "title": "Strata browser benchmark session v1",
  "description": "RAF callback cadence, CPU submission and optional GPU pass timings are separate. All units are milliseconds or bytes. Additional metadata is permitted. A session includes one or more runs.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "createdAt",
    "mode",
    "host",
    "source",
    "browser",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "strata-local-benchmark-session"
    },
    "createdAt": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "performance",
        "sustained",
        "smoke"
      ]
    },
    "host": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "browser": {
      "type": "object"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "integratedTelemetry": {
      "type": "object",
      "required": [
        "fixture",
        "cameraPath",
        "renderRepresentation",
        "tracingRepresentation",
        "collisionRepresentation",
        "terrainColor",
        "staticRasterTriangles",
        "persistentProxyTriangles",
        "totalTraceTriangles",
        "traceProxyPayloadBytes",
        "terrainScale",
        "terrainYOffset",
        "probeVolume",
        "outdoorGiSupported",
        "proxySourceManifestSha256",
        "proxyPayloadSha256",
        "proxyMaxVerticalError",
        "proxyMeasuredMaxVerticalError"
      ],
      "properties": {
        "fixture": {
          "const": "streamed-courtyard-v1"
        },
        "cameraPath": {
          "enum": [
            "integrated-tour-v1",
            "integrated-receiver-v1",
            "integrated-overview-v1",
            "integrated-terrain-witness-v1"
          ]
        },
        "renderRepresentation": {
          "const": "streamed-terrain-and-exact-room-v1"
        },
        "tracingRepresentation": {
          "const": "persistent-terrain-proxy-and-exact-room-v1"
        },
        "collisionRepresentation": {
          "const": "none"
        },
        "terrainColor": {
          "enum": [
            "green",
            "neutral"
          ]
        },
        "staticRasterTriangles": {
          "const": 312
        },
        "persistentProxyTriangles": {
          "const": 2048
        },
        "totalTraceTriangles": {
          "const": 2204
        },
        "traceProxyPayloadBytes": {
          "const": 37644
        },
        "terrainScale": {
          "const": 0.125
        },
        "terrainYOffset": {
          "const": -1.625
        },
        "probeVolume": {
          "const": "fixed-room-grid-v1"
        },
        "outdoorGiSupported": {
          "const": false
        },
        "proxySourceManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proxyPayloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proxyMaxVerticalError": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.19
        },
        "proxyMeasuredMaxVerticalError": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.19
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "integratedWorkload": {
      "type": "object",
      "required": [
